# Söztek QR Menü — ortam değişkenleri örneği
# Gerçek .env dosyası git'e girmez. Bu dosyayı .env olarak kopyalayıp doldurun.

# PostgreSQL bağlantısı
# Yerel: postgresql://postgres:postgres@localhost:5432/qrmenu?schema=public
# Production (Neon): postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Oturum imzalama anahtarı — güçlü rastgele bir değer üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Uygulama kök adresi (QR kod ve menü linkleri)
# Yerel: http://localhost:3000
# Production: https://www.soztekqrmenu.com.tr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (ürün fotoğrafı depolama) — Vercel'de Blob store oluşturunca gelir.
# Yerelde boş bırakılırsa dosyalar public/uploads'a yazılır.
BLOB_READ_WRITE_TOKEN=

# Süper admin e-postaları (virgülle ayrılmış). Bu e-postayla kayıt/giriş yapan
# kullanıcı /admin paneline erişir. Örn: olgunersin@hotmail.com
ADMIN_EMAILS=
