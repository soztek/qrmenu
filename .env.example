# Söztek QR Menü — ortam değişkenleri örneği
# Gerçek .env dosyası git'e girmez. Bu dosyayı .env olarak kopyalayıp doldurun.

# PostgreSQL bağlantısı
# Yerel: postgresql://postgres:postgres@localhost:5432/qrmenu?schema=public
# Production (Neon): postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Oturum imzalama anahtarı — güçlü rastgele bir değer üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Uygulama kök adresi (QR kod ve menü linkleri)
# Yerel: http://localhost:3000
# Production: https://www.soztekqrmenu.com.tr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (ürün fotoğrafı depolama) — Vercel'de Blob store oluşturunca gelir.
# Yerelde boş bırakılırsa dosyalar public/uploads'a yazılır.
BLOB_READ_WRITE_TOKEN=

# Süper admin e-postaları (virgülle ayrılmış). Bu e-postayla kayıt/giriş yapan
# kullanıcı /admin paneline erişir. Örn: olgunersin@hotmail.com
ADMIN_EMAILS=

# Anthropic API anahtarı — menüde "Yapay zeka ile kalori tahmini" için.
# Boş bırakılırsa özellik kapalı olur (yerleşik tablo yine çalışır).
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Ödeme (abonelik) ──
# Hangi sağlayıcıyla anlaşırsan onun bilgilerini gir; sistem otomatik onu kullanır.
# İkisi de doluysa PAYMENT_PROVIDER ile hangisinin aktif olacağını seç ("paytr"|"iyzico").
# Hiçbiri dolu değilse ödeme kapalı (deneme sürümü) olur.
PAYMENT_PROVIDER=

# PayTR — bayi panelinden alınır.
# Bildirim (callback) URL: https://www.soztekqrmenu.com.tr/api/paytr/callback
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Test için "1" (gerçek çekim olmaz); canlıda "0" ya da boş.
PAYTR_TEST_MODE=1

# iyzico — Checkout Form. Callback URL: https://www.soztekqrmenu.com.tr/api/iyzico/callback
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox (test): https://sandbox-api.iyzipay.com · Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
