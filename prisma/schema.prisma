// Söztek QR Menü — veri şeması
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Paket kimlikleri — src/lib/plans.ts ile aynı.
enum PlanId {
  starter
  pro
  premium
}

/// Abonelik durumu.
enum SubscriptionStatus {
  trialing // ücretsiz deneme sürüyor
  active // ödemesi yapılmış, aktif
  past_due // ödeme başarısız
  canceled // iptal edilmiş / süresi dolmuş
}

/// Kullanıcı rolü.
enum Role {
  owner // işletme sahibi (üye)
  admin // platform süper admin (biz)
}

/// Hesap sahibi — işletmeye kayıt olan kişi.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         Role      @default(owner)
  business     Business?
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Oturum — httpOnly cookie'deki token bu satıra karşılık gelir.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Bir işletme (kafe/restoran) — kayıt sonrası oluşturulur.
model Business {
  id     String @id @default(cuid())
  owner  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  name        String
  slug        String  @unique // herkese açık menü URL'i: /m/<slug>
  description String?
  logoUrl     String?
  coverUrl    String? // menü üstündeki kapak görseli
  menuTheme   String  @default("dark") // herkese açık menü renk teması
  menuPaused  Boolean @default(false) // admin QR'ı durdurunca müşteri bakım ekranı görür

  // İletişim / bilgi (menüdeki bilgi panelinde gösterilir)
  phone        String?
  whatsapp     String? // WhatsApp numarası (menüde tıkla-yaz butonu)
  address      String?
  mapsUrl      String? // Google Maps linki
  instagram    String? // kullanıcı adı ya da tam URL
  wifiName     String?
  wifiPassword String?
  workingHours String? // serbest metin, ör. "Her gün 09:00 - 23:00"

  // Abonelik / deneme durumu
  plan                 PlanId             @default(starter)
  subscriptionStatus   SubscriptionStatus @default(trialing)
  trialEndsAt          DateTime // kayıt + 7 gün
  currentPeriodEnd     DateTime? // aktif abonelikte dönem sonu
  trialReminderSentAt  DateTime? // deneme bitiş hatırlatma maili gönderildi mi

  categories Category[]
  menuItems  MenuItem[]
  tables     RestaurantTable[]
  reviews    Review[]
  menuVisits MenuVisit[]
  payments   Payment[]

  // Sosyal medya asistanı (Instagram vb.)
  socialAccounts  SocialAccount[]
  socialPosts     SocialPost[]
  socialSchedule  SocialSchedule?
  socialSettings  SocialSettings?
  socialTemplates SocialTemplate[]

  // Masadan sipariş sistemi (Pro/Premium)
  orderSettings   OrderSettings?
  tableSessions   TableSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  kitchenStations KitchenStation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionStatus])
}

/// Menü kategorisi (ör. Kahveler, Tatlılar).
model Category {
  id         String     @id @default(cuid())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  imageUrl   String? // kategori kartı görseli
  sortOrder  Int        @default(0)
  items      MenuItem[]
  createdAt  DateTime   @default(now())

  @@index([businessId])
}

/// Müşteri yorumu — yalnızca işletme onaylayınca (isApproved) menüde görünür.
model Review {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  authorName String
  rating     Int // 1-5
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId, isApproved])
}

/// Menü ürünü.
model MenuItem {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  photoUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)

  // Yasal uyumluluk / şeffaf menü (hepsi opsiyonel)
  calories        Int? // porsiyon başına kcal
  protein         Decimal? @db.Decimal(5, 1) // g
  fat             Decimal? @db.Decimal(5, 1) // g
  carbs           Decimal? @db.Decimal(5, 1) // g
  allergens       String[] @default([]) // alerjen anahtarları (gluten, sut, ...)
  meatType        String? // dana, kuzu, kanatli, balik, karisik
  containsAlcohol Boolean  @default(false)
  containsPork    Boolean  @default(false)

  // Sipariş sistemi alanları (opsiyonel — sipariş kapalıyken kullanılmaz)
  discountPrice Decimal?    @db.Decimal(10, 2) // indirimli fiyat
  prepMinutes   Int? // tahmini hazırlanma süresi (dk)
  stockQty      Int? // null = stok takibi yok; sayı = günlük kalan adet
  stockStatus   StockStatus @default(in_stock)
  isOrderable   Boolean     @default(true) // menüde görünür ama siparişe kapalı olabilir
  station       KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  stationId     String?

  socialPosts    SocialPost[] // bu üründen üretilen sosyal medya gönderileri
  modifierGroups ModifierGroup[] // ürün seçenekleri (boyut, ekstra vb.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([categoryId])
  @@index([stationId])
}

/// Günlük ziyaret sayacı (herkese açık sayfalar). kind: "landing" | "menu".
model PageVisit {
  day   DateTime @db.Date
  kind  String
  count Int      @default(0)

  @@id([day, kind])
}

/// PayTR ödeme kaydı — tek seferlik abonelik satın alımı.
model Payment {
  id          String    @id @default(cuid())
  merchantOid String    @unique // sipariş no / conversationId (alfanümerik)
  provider    String    @default("paytr") // paytr | iyzico
  providerRef String? // iyzico checkout token vb.
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  plan        PlanId
  period      String // "monthly" | "yearly"
  days        Int // erişime eklenecek gün
  amount      Int // kuruş (₺199 -> 19900)
  status      String    @default("pending") // pending | success | failed
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([businessId])
  @@index([providerRef])
}

/// İşletme bazlı günlük menü ziyareti (hangi menü kaç kez açıldı).
model MenuVisit {
  day        DateTime @db.Date
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  count      Int      @default(0)

  @@id([day, businessId])
  @@index([businessId])
}

/// Masa — masaya özel QR için güvenli qrToken (tahmin edilemez, yenilenebilir).
model RestaurantTable {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  branchId   String? // ileriye dönük (çok şube)
  label      String // ör. "Masa 5"
  qrToken    String   @unique @default(cuid())
  active     Boolean  @default(true) // pasif token okutulunca hata ekranı
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  sessions        TableSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────
// AI Sosyal Medya Asistanı — çok kiracılı (her işletme kendi verisi).
// v1: yalnızca Instagram aktif; mimari diğer platformlara açık.
// ─────────────────────────────────────────────────────────────

/// Sosyal medya platformları — v1'de yalnızca instagram aktif.
enum SocialPlatform {
  instagram
  facebook
  tiktok
  google_business
}

/// Bağlı hesap durumu.
enum SocialAccountStatus {
  active
  expired
  revoked
}

/// Gönderi durumu (onay akışı). v1: otomatik paylaşım yok, önce onay.
enum SocialPostStatus {
  draft
  pending_approval
  approved
  scheduled
  publishing
  published
  failed
  rejected
}

/// İçerik türü.
enum SocialPostType {
  product
  restaurant
  menu
  campaign
  qr_menu
  educational
  customer_acquisition
  special_day
  auto
}

/// Bir işletmenin bağladığı sosyal medya hesabı (OAuth).
/// Access token AES-GCM ile şifreli saklanır; asla frontend'e gönderilmez.
model SocialAccount {
  id         String              @id @default(cuid())
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  platform   SocialPlatform      @default(instagram)
  status     SocialAccountStatus @default(active)

  providerUserId    String // IG business account id
  username          String?
  displayName       String?
  profilePictureUrl String?
  pageId            String? // IG yayını için bağlı Facebook sayfası id'si

  accessTokenEnc String // şifrelenmiş uzun ömürlü token
  tokenExpiresAt DateTime?

  posts     SocialPost[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([businessId, platform])
  @@index([businessId])
}

/// AI ile üretilen / paylaşılan sosyal medya gönderisi.
model SocialPost {
  id         String           @id @default(cuid())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  account    SocialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId  String?
  platform   SocialPlatform   @default(instagram)
  type       SocialPostType   @default(product)
  status     SocialPostStatus @default(draft)

  // Kaynak ürün (menü verisinden üretim) — silinirse gönderi kalır.
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  menuItemId String?

  // İçerik
  title    String?
  body     String?  @db.Text
  cta      String?
  caption  String?  @db.Text // IG'ye gidecek nihai açıklama (birleşik)
  hashtags String[] @default([])

  // Görsel
  imageUrl       String? // nihai kompoze edilmiş görsel (1080x1350 / 1080x1080)
  sourceImageUrl String? // kullanılan ürün/restoran fotoğrafı
  imageConcept   String? @db.Text // görsel yoksa AI görsel konsepti
  format         String  @default("portrait") // portrait | square

  // Zamanlama / yayın
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalPostId String? // IG media id
  permalink      String?
  errorMessage   String?   @db.Text
  retryCount     Int       @default(0)

  aiModel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([scheduledAt])
  @@index([accountId])
  @@index([menuItemId])
}

/// Otomatik içerik takvimi ayarı (işletme başına tek kayıt).
model SocialSchedule {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @unique

  enabled      Boolean  @default(false)
  postsPerWeek Int      @default(3)
  types        String[] @default([]) // seçili içerik türleri
  plan         Json? // gün → tür / saat eşlemesi
  timezone     String   @default("Europe/Istanbul")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// İşletme başına sosyal medya ayarları / marka tonu.
model SocialSettings {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @unique

  brandTone       String?
  defaultHashtags String[] @default([])
  includeQrLink   Boolean  @default(true)
  includeLogo     Boolean  @default(true)
  autoPublish     Boolean  @default(false) // v1: kapalı — her zaman onay istenir

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Görsel / açıklama şablonu. businessId null → platform varsayılanı.
model SocialTemplate {
  id         String    @id @default(cuid())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?
  name       String
  kind       String // "image" | "caption"
  config     Json
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────
// Masadan Sipariş Sistemi (Pro/Premium) — çok kiracılı (businessId ile izole).
// v1: tek işletme/şube, sahip panelinden yönetim. branchId ileriye dönük.
// ─────────────────────────────────────────────────────────────

/// Sipariş durumu (hazırlanma akışı — ödemeden bağımsız).
enum OrderStatus {
  pending // işletme onayı bekliyor
  accepted // kabul edildi
  preparing // hazırlanıyor
  ready // servise hazır
  served // teslim edildi
  cancelled // iptal
  rejected // reddedildi
}

/// Ödeme durumu (sipariş durumundan ayrı).
enum PaymentStatus {
  unpaid
  payment_requested
  paid
  partially_paid
  refunded
}

/// Açık masa hesabı durumu.
enum TableSessionStatus {
  active
  payment_requested
  closed
}

/// Sipariş kaynağı (ileride ekstra kanallar).
enum OrderSource {
  qr_menu
}

/// Sipariş kabul modu.
enum OrderAcceptMode {
  staff // önce personel onayı
  auto // doğrudan mutfağa
}

/// Servis talebi türü.
enum ServiceRequestType {
  waiter
  bill
  water
  cleaning
  other
}

/// Servis talebi durumu.
enum ServiceRequestStatus {
  pending
  acknowledged
  completed
  cancelled
}

/// Ürün stok durumu.
enum StockStatus {
  in_stock
  out_of_stock
  disabled // geçici satışa kapalı
}

/// İşletme sipariş ayarları (işletme başına tek kayıt).
model OrderSettings {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String   @unique
  branchId   String?

  qrOrderingEnabled  Boolean         @default(false) // kapalıysa QR menü normal menü gibi çalışır
  acceptMode         OrderAcceptMode @default(staff)
  callWaiterEnabled  Boolean         @default(true)
  requestBillEnabled Boolean         @default(true)
  askCustomerName    Boolean         @default(false)
  allowNotes         Boolean         @default(true)
  serviceRequestTypes String[]       @default([]) // aktif çağrı türleri (boş = varsayılan)
  minOrderTotal      Decimal?        @db.Decimal(10, 2)
  acceptFrom         String? // "09:00"
  acceptTo           String? // "23:00"
  prepWarnMins       Int             @default(15)
  soundEnabled       Boolean         @default(true)
  kitchenEnabled     Boolean         @default(true)
  stockControl       Boolean         @default(true)
  currency           String          @default("TRY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Açık masa oturumu (hesap). Aynı masanın siparişleri tek oturumda toplanır.
model TableSession {
  id         String             @id @default(cuid())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  table      RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId    String
  branchId   String?
  status     TableSessionStatus @default(active)
  customerName String?
  openedAt   DateTime           @default(now())
  closedAt   DateTime?
  closedById String?

  orders          Order[]
  serviceRequests ServiceRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([businessId, status])
  @@index([tableId, status])
}

/// Sipariş. total backend'de hesaplanır; kalem bilgileri snapshot.
model Order {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  branchId   String?

  // Masa/oturum silinirse geçmiş sipariş korunur (SetNull + snapshot label).
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableId    String?
  session    TableSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId  String?
  tableLabel String // snapshot

  code           String // personel için kısa: "S-1042"
  seq            Int // işletme içi artan sıra
  source         OrderSource   @default(qr_menu)
  status         OrderStatus   @default(pending)
  paymentStatus  PaymentStatus @default(unpaid)
  paymentMethod  String?

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)

  customerName   String?
  note           String?
  idempotencyKey String  @unique // mükerrer sipariş koruması

  acceptedAt DateTime?
  readyAt    DateTime?
  servedAt   DateTime?

  items     OrderItem[]
  events    OrderEvent[]
  printJobs PrintJob[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([sessionId])
  @@index([tableId])
  @@index([businessId, createdAt])
}

/// Sipariş kalemi — sipariş anındaki ürün bilgisi snapshot olarak saklanır.
model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  menuItemId String? // ürün silinse de snapshot kalır (ilişki yok, düz id)

  name      String
  imageUrl  String?
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  taxRate   Decimal? @db.Decimal(5, 2)
  lineTotal Decimal  @db.Decimal(10, 2)
  note      String?
  stationId String?

  modifiers OrderItemModifier[]
  createdAt DateTime            @default(now())

  @@index([orderId])
}

/// Sipariş kalemi seçeneği (boyut, ekstra vb.) — fiyat snapshot.
model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  groupName   String?
  name        String
  price       Decimal   @db.Decimal(10, 2) @default(0)

  @@index([orderItemId])
}

/// Sipariş durum geçiş logu (audit).
model OrderEvent {
  id         String       @id @default(cuid())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  byUserId   String?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

/// Servis talebi (garson çağır, hesap iste, su, temizlik...).
model ServiceRequest {
  id         String               @id @default(cuid())
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  table      RestaurantTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableId    String?
  tableLabel String?
  session    TableSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId  String?
  type       ServiceRequestType
  status     ServiceRequestStatus @default(pending)
  note       String?
  handledById String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([businessId, status])
}

/// Hazırlık istasyonu (Mutfak, Bar, Tatlı...). v1: varsayılan tek "Mutfak".
model KitchenStation {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  name       String
  sortOrder  Int      @default(0)

  items     MenuItem[]
  createdAt DateTime   @default(now())

  @@index([businessId])
}

/// Ürün seçenek grubu (ör. Boyut, Ekstralar).
model ModifierGroup {
  id         String  @id @default(cuid())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  required   Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  sortOrder  Int     @default(0)

  options   ModifierOption[]
  createdAt DateTime         @default(now())

  @@index([menuItemId])
}

/// Seçenek (ör. Büyük +30, Ekstra peynir +15).
model ModifierOption {
  id          String        @id @default(cuid())
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  name        String
  priceDelta  Decimal       @db.Decimal(10, 2) @default(0)
  isAvailable Boolean       @default(true)
  sortOrder   Int           @default(0)

  @@index([groupId])
}

/// Mutfak fişi yazdırma geçmişi (mükerrer yazdırma takibi).
model PrintJob {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  printedAt DateTime @default(now())
  count     Int      @default(1)

  @@index([orderId])
}
